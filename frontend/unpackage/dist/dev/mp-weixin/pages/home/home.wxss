		            0 0 15rpx rgba(255, 150, 0, 0.6);
}
	
	/* 离子位置分布 - 完美圆形环绕，离中心较近 */
	/* 上方 */
.ion-1 { top: 8%; left: 50%; animation-delay: 0s;
}
	/* 右上 */
