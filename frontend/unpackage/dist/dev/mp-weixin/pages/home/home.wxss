	/* 对抗条和投票区域 */
.battle-section {
		background-color: #FFFFFF !important;
		background: #FFFFFF !important;
		border: 6rpx solid #000;
		border-radius: 30rpx;
		padding: 30rpx;
		margin-bottom: 20rpx;
		display: flex;
		flex-direction: column;
		opacity: 1 !important;
		position: relative;
		z-index: 10;
}
	/* 对抗条 */
.battle-bar {
		height: 60rpx;
		background: transparent;
		border: none;
		border-radius: 12rpx;
		position: relative;
		overflow: hidden;
		display: flex;
		animation: none;
		box-shadow: none;
		margin-bottom: 8rpx;
}
.battle-fill {
		height: 100%;
		position: relative;
		transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		align-items: center;
		justify-content: flex-end;
		overflow: hidden;
		border-radius: 12rpx;
		border: 4rpx solid #000;
}
.left-fill {
		background: #FF0000;
		animation: none;
		box-shadow: none;
}
.right-fill {
		background: #0066FF;
		animation: none;
		box-shadow: none;
}
.battle-text {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4rpx;
}
.left-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 4rpx;
}
.right-text {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: center;
		gap: 4rpx;
}
.battle-label {
		display: none;
}
.battle-count {
		font-size: 24rpx;
