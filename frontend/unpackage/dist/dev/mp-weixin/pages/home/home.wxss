	/* 周围跳动的小火焰离子 */
.flame-ions {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		pointer-events: none;
		overflow: visible;
}
.ion {
		position: absolute;
		font-size: 18rpx;
		animation: ionBounce 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
		filter: drop-shadow(0 0 10rpx rgba(255, 0, 255, 0.95))
		        drop-shadow(0 0 18rpx rgba(255, 69, 0, 0.8))
