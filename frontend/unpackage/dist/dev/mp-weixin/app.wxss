@font-face {
  font-family: "iconfont";
  src: url('iconfont.woff2?t=1703123456789') format('woff2'),
       url('iconfont.woff?t=1703123456789') format('woff'),
       url('iconfont.ttf?t=1703123456789') format('truetype');
}
.iconfont {
  font-family: "iconfont" !important;
  font-size: 16px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
